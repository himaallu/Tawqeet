  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --clear-screen=false --ignore client --ignore dist server/index.ts",
    "worker": "tsx worker/index.ts",
    "build": "vite build",
    "start": "concurrently -k -n web,worker -c blue,magenta \"NODE_ENV=production tsx server/index.ts\" \"NODE_ENV=production tsx worker/index.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:keys": "tsx scripts/check-keys.ts"
  },
