# Tawqeet environment variables. Copy to .env locally (never commit it; .env* is gitignored)
# or add them as Replit Secrets. Values here are intentionally empty.
# Run `pnpm run check:env` to see what is missing and live-test each configured service.

# ── Core ─────────────────────────────────────────────────────────────
# [required] PostgreSQL connection string (Replit provisions it automatically).
DATABASE_URL=
# [required] Random string, at least 32 characters, used to hash session tokens.
SESSION_SECRET=
# [required in production] Public HTTPS origin, e.g. https://tawqeet.replit.app (dev falls back to REPLIT_DEV_DOMAIN).
APP_URL=
# [required] Agency owner's email; only this address can claim the owner account.
OWNER_EMAIL=
# [optional] 64 hex characters (openssl rand -hex 32). Required before connecting Gmail/Outlook mailboxes.
ENCRYPTION_KEY=
# [optional] Set by Replit in development; used for the preview origin and OAuth redirect URIs.
REPLIT_DEV_DOMAIN=
# [optional] Runtime/platform settings, normally set by Replit or scripts.
NODE_ENV=
PORT=
BASE_PATH=
API_PORT=
WEB_PORT=
SERVE_WEB=
# [optional] pino log level (info by default).
LOG_LEVEL=

# ── AI ───────────────────────────────────────────────────────────────
# [required for AI features] Provider used by Brain/writer: gemini, anthropic or openai.
AI_PROVIDER=
# [required for AI features] Model name for AI_PROVIDER.
AI_MODEL=
# [optional] Provider keys; set at least the one matching AI_PROVIDER.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# [optional] Cheap model for demo writer/persona calls when ANTHROPIC_API_KEY is set.
DEMO_AI_MODEL=
# [optional] Gemini model for Gmail-style summaries.
GEMINI_SUMMARY_MODEL=
# [optional] USD prices per million tokens, used to report AI cost on Billing.
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=

# ── Data ─────────────────────────────────────────────────────────────
# [optional] LeadOcean contact search; without it demo contacts are labeled samples.
LEADOCEAN_API_KEY=
# [optional] HubSpot private-app token (companies + deals read) for CRM import.
HUBSPOT_TOKEN=
# [optional] Firecrawl hosted scraper for website crawling.
FIRECRAWL_API_KEY=
# [optional] Comma-separated RSS feed URLs for the signal radar.
SIGNAL_NEWS_FEEDS=
# [optional] Comma-separated technologies to watch for tech-adoption signals.
SIGNAL_TECHNOLOGIES=
# [optional] Replit App Storage for Brain document uploads.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Email ────────────────────────────────────────────────────────────
# [required] Sender for magic links, demo sends and alerts (onboarding@resend.dev for testing).
RESEND_FROM_EMAIL=
# [optional] Direct Resend API key; otherwise the Replit Resend connector is used.
RESEND_API_KEY=
# [optional] Gmail OAuth (gmail.send scope only) for real mailbox sending.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [optional] Microsoft Graph OAuth (Mail.Send only) for real mailbox sending.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# [optional] true = approved emails go to the actual lead via the connected mailbox. Default false (demo recipient only).
REAL_SEND=
# [optional] Resend inbound webhook signing secret (whsec_…); enables POST /api/webhooks/inbound reply capture.
INBOUND_WEBHOOK_SECRET=

# ── Alerts ───────────────────────────────────────────────────────────
# [optional] Demo email + alert/digest recipient (falls back to OWNER_EMAIL).
ALERT_EMAIL_TO=
# [optional] Make.com webhook receiving Hot-lead JSON (default fan-out to Trello/SMS/Asana/ClickUp).
ALERT_WEBHOOK_URL=
# [optional] Direct Trello cards (all three required).
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
# [optional] Direct Twilio SMS (all four required).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
# [optional] Direct Asana tasks (both required).
ASANA_TOKEN=
ASANA_PROJECT_ID=
# [optional] Direct ClickUp tasks (both required).
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

# ── Billing ──────────────────────────────────────────────────────────
# [optional] Stripe Payment Link opened by Billing → Upgrade (button hidden when unset).
STRIPE_PAYMENT_LINK=
# [optional] Reserved for Stripe API checkout/webhooks (not used yet).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Integrations / landing ───────────────────────────────────────────
# [optional] "Book a demo" link on /welcome (falls back to mailto:OWNER_EMAIL).
BOOK_DEMO_URL=

# ── Demo ─────────────────────────────────────────────────────────────
# [optional] true enables the shared demo sign-in and Load demo data. Never on a private production agency.
DEMO_MODE=
# [optional] Base URL for `pnpm run smoke` (defaults to APP_URL).
SMOKE_URL=
