modules = ["nodejs-22", "postgresql-16"]
run = "npm run dev"

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["sh", "-c", "npm run db:migrate && npm start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Worker"

[[workflows.workflow]]
name = "Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run worker"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "alluhimasri@gmail.com"
EMAIL_FROM = "auth@tuezdayai.com"
AI_PROVIDER = "anthropic"
AI_MODEL = "claude-sonnet-4-5"

[nix]
channel = "stable-25_05"
